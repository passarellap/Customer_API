{
  "ConnectionStrings": {
    "TreePlatConnection": "Data Source=localhost\\MSSQLSERVER01; Initial Catalog=DevTreeplat; Trusted_Connection=True; Min Pool Size=40; Connect Timeout=300; MultipleActiveResultSets=True;"
  },
  "SecuritySettings": {
    "enableIdentityServer": true,
    "authorityUrl": "https://stags-login.gabettigroup.com",
    "requiredScope": "anagrafica-api",
    "clientId": "anagrafica-api_swagger",
    "secret": "secret"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:6002"
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Graylog" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "===> {Timestamp:HH:mm:ss.fff zzz} [{Level}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Graylog",
        "Args": {
          "hostnameOrAddress": "10.70.32.61",
          "port": "12202",
          "transportType": "Udp"
        }
      }
    ]
  },
  "AppSettings": {
    "CorsEnabledDomains": [ "http://localohost:4200" ]
  }
}
